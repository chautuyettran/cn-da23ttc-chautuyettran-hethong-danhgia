PORT=3000
NODE_ENV=development
COOKIE_SECURE=false
MIN_REPORT_RESPONSES=5
SEED_STUDENT_EMAIL=
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional generic one-time lecturer provisioning.
LECTURER_NAME=
LECTURER_EMAIL=
LECTURER_PASSWORD=
LECTURER_DEPARTMENT=
# Local test lecturer account; never commit values from your local .env.
TEST_LECTURER_PASSWORD=
TEST_LECTURER_NAME=
TEST_LECTURER_DEPARTMENT=
JWT_SECRET=
# MongoDB credentials bootstrap users only on first initialization of mongo_data.
# Changing these values later does not change users already stored in MongoDB.
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
# Application credentials are stored in the teaching_quality database.
MONGO_APP_USERNAME=
MONGO_APP_PASSWORD=
MONGO_REPLICA_KEY=
# Optional Twilio SMS delivery for student password recovery.
# Configure all four values to enable real OTP delivery.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
